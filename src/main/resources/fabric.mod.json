{
  "schemaVersion": 1,
  "id": "polycard",
  "version": "${version}",
  "name": "PolyCard",
  "description": "Collectible card system - find cards and equip them for buffs.",
  "authors": [
    "Timeo",
    "RenardElectric"
  ],
  "license": "MIT",
  "icon": "assets/polycard/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "polycube.polycard.PolyCard"
    ],
    "fabric-datagen": [
      "polycube.polycard.DataGenerator"
    ]
  },
  "mixins": [
    "polycard.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": "~26.1.2-",
    "java": ">=25",
    "fabric-api": "*"
  },
  "accessWidener": "polycard.classtweaker"
}